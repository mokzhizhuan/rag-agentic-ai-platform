   async function send(){
     if(busy||(question.trim().length<2 && !chatFiles.length))return;
     const text=question.trim()||'Please analyze the selected file(s).';const requestFiles=[...chatFiles];setBusy(true);setError('');setNotice('');setMemoryFeedback('');
     setPendingQuestion(text+((requestFiles.length)?'\n[Files: '+requestFiles.map(f=>f.name).join(', ')+']':''));setStreamText('');setStreamSources([]);setStreamStatus('Connecting...');setToolStatus('');setQuestion('');
     let completed=false;
     try{
       await keycloak.updateToken(30);
       const form=new FormData();
       form.append('question',text); form.append('provider',provider);form.append('mode',mode);
       if(activeId!==null) form.append('conversation_id',String(activeId));
       requestFiles.forEach(f=>form.append('files',f));
       const response=await fetch(API+'/api/chat/ask-stream/',{
         method:'POST',headers:{'Accept':'text/event-stream','Authorization':`Bearer ${keycloak.token}`},
         body:form
       });
       if(!response.ok){
         const body=await response.json().catch(()=>({}));
         throw new Error(`${response.status}: ${typeof body.detail==='string'?body.detail:JSON.stringify(body.detail??body)}`);
       }
       if(!response.body)throw new Error('Browser did not provide a streaming response');
       const reader=response.body.getReader();const decoder=new TextDecoder();let buffer='';
       const handleEvent=(frame:string)=>{
         let event='message';const dataLines:string[]=[];
         for(const line of frame.split('\n')){
           if(line.startsWith('event:'))event=line.slice(6).trim();
           if(line.startsWith('data:'))dataLines.push(line.slice(5).trimStart());
         }
         if(!dataLines.length)return;
         const payload=JSON.parse(dataLines.join('\n'));
         if(event==='status')setStreamStatus(payload.message||'Working...');
         if(event==='tool')setToolStatus(`${payload.name}: ${payload.status}`);
         if(event==='sources')setStreamSources(payload.sources||[]);
         if(event==='token')setStreamText(v=>v+(payload.text||''));
         if(event==='memory_saved'){
           const saved=Array.isArray(payload.memories)?payload.memories:[];
           if(saved.length){
             setMemories(previous=>{const seen=new Set(previous.map(m=>m.id));return [...saved.filter((m:Memory)=>!seen.has(m.id)),...previous];});
             setMemoryFeedback(`${saved.length} new memor${saved.length===1?'y':'ies'} saved automatically.`);
           }
         }
         if(event==='error')throw new Error(payload.detail||'Chat streaming failed');
         if(event==='done'){
           completed=true;
           setActiveId(payload.conversation.id);
           setMessages(v=>[...v,payload.user_message,payload.assistant_message]);
           setStreamText('');setStreamSources([]);setPendingQuestion('');setStreamStatus('');setChatFiles([]);
         }
       };
       try{
         while(true){
           const {done,value}=await reader.read();if(done)break;
           buffer+=decoder.decode(value,{stream:true}).replace(/\r\n/g,'\n');
           let index;
           while((index=buffer.indexOf('\n\n'))!==-1){
             const frame=buffer.slice(0,index);buffer=buffer.slice(index+2);
             if(frame.trim())handleEvent(frame);
           }
         }
         buffer+=decoder.decode();
         if(buffer.trim())handleEvent(buffer);
       }finally{reader.releaseLock();}
       if(!completed)throw new Error('Connection closed before the answer was saved');
       await refresh();
     }catch(e){setError(String(e));setQuestion(text);}
     finally{setBusy(false);setStreamStatus('');if(!completed){setStreamText('');setStreamSources([]);setPendingQuestion('');}}
   }
