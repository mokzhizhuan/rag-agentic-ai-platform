    if(!newCharacterImage||!newCharacterName.trim())return;
    setCharacterBusy(true);setError('');
    try{
      const body=new FormData();body.append('name',newCharacterName.trim());body.append('description',newCharacterDescription.trim());body.append('image',newCharacterImage);
