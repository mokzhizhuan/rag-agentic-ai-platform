  async function refreshGenerationJobs(){
    const result=await api('/api/artifacts/jobs/');
    const jobs:GenerationJob[]=result.jobs||[];
    setGenerationJobs(jobs);
    const active=jobs.some(j=>j.status==='queued'||j.status==='running');
    setArtifactBusy(active);
    const latest=jobs[0];
    if(latest?.status==='completed')setArtifactStatus('Completed — artifact available below.');
    if(latest?.status==='failed')setArtifactStatus('Generation failed: '+latest.error);
    if(latest?.status==='running'||latest?.status==='queued')setArtifactStatus(latest.stage);
    if(latest?.status==='completed')await refreshArtifacts();
  }
  async function generateArtifact(){
    if(artifactBusy||artifactPrompt.trim().length<5)return;
    setArtifactBusy(true);setArtifactStatus('Queuing generation...');setError('');
    try{
      const body=new FormData();
      body.append('prompt',artifactPrompt.trim());
      body.append('provider',provider);
      body.append('format',artifactFormat);
      body.append('reference_handling',referenceHandling);
      body.append('reference_controls',JSON.stringify({preset:referencePreset,references:artifactFiles.map((f,i)=>({name:f.name,roles:referenceWeights[i]??presetWeights[referencePreset]}))}));
      body.append('character_lock',String(characterLock));
      if(selectedCharacter)body.append('character_id',selectedCharacter);
      if(artifactFormat==='video_clip'||artifactFormat==='video_reel')body.append('duration',(artifactFormat==='video_reel'&&!['30','60'].includes(videoDuration))?'30':(artifactFormat==='video_clip'&&!['5','8','10','15'].includes(videoDuration))?'8':videoDuration);
      if(activeId!==null)body.append('conversation_id',String(activeId));
      for(const file of artifactFiles)body.append('files',file);
      await api('/api/artifacts/jobs/',{method:'POST',body});
      setArtifactStatus('Queued — waiting for the generation worker.');
      await refreshGenerationJobs();
    }catch(e){setArtifactStatus('');setError(String(e));setArtifactBusy(false);}
  }
  async function cancelGenerationJob(id:number){
    try{await api(`/api/artifacts/jobs/${id}/`,{method:'DELETE'});await refreshGenerationJobs();}catch(e){setError(String(e));}
  }
  const displayElapsed=(
    start:string|null,
    end:string|null
  ):string=>{
    if(!start)return '00:00';

    const startMs=Date.parse(start);
    const endMs=end?Date.parse(end):clockNow;

    if(!Number.isFinite(startMs)||!Number.isFinite(endMs)){
      return '00:00';
    }

    const totalSeconds=Math.max(
      0,
      Math.floor((endMs-startMs)/1000)
    );

    const hours=Math.floor(totalSeconds/3600);
    const minutes=Math.floor((totalSeconds%3600)/60);
    const seconds=totalSeconds%60;

    if(hours>0){
      return `${String(hours).padStart(2,'0')}:${String(minutes).padStart(2,'0')}:${String(seconds).padStart(2,'0')}`;
    }

    return `${String(minutes).padStart(2,'0')}:${String(seconds).padStart(2,'0')}`;
  };
  async function validateZipProject(a:Artifact){
    if(zipValidating!==null)return;
    setZipValidating(a.id);
    setZipValidationErrors(v=>({...v,[a.id]:''}));
    try{
      const result=await api(`/api/artifacts/${a.id}/validate-project/`,{method:'POST'});
      setZipReports(v=>({...v,[a.id]:result.report as ZipValidationReport}));
    }catch(e){setZipValidationErrors(v=>({...v,[a.id]:String(e)}));}
    finally{setZipValidating(null);}
  }
  async function downloadZipReport(a:Artifact){
    try{
      await keycloak.updateToken(30);
      const response=await fetch(API+`/api/artifacts/${a.id}/validate-project/`,{headers:{Authorization:`Bearer ${keycloak.token}`}});
      if(!response.ok)throw new Error('Report download failed: HTTP '+response.status);
      const blob=await response.blob();const url=URL.createObjectURL(blob);
      const link=document.createElement('a');link.href=url;link.download=a.filename.replace(/\.zip$/i,'')+'.validation.md';document.body.append(link);link.click();link.remove();
      setTimeout(()=>URL.revokeObjectURL(url),30000);
    }catch(e){setZipValidationErrors(v=>({...v,[a.id]:String(e)}));}
  }
  async function downloadArtifact(a:Artifact){
    try{
      await keycloak.updateToken(30);
      const r=await fetch(API+a.download_path,{headers:{Authorization:`Bearer ${keycloak.token}`}});
      if(!r.ok)throw new Error('Download failed: HTTP '+r.status);
      const blob=await r.blob();const url=URL.createObjectURL(blob);
      const link=document.createElement('a');link.href=url;link.download=a.filename;document.body.append(link);link.click();link.remove();
      setTimeout(()=>URL.revokeObjectURL(url),30000);
    }catch(e){setError(String(e));}
  }
  async function closePreview(){
    if(previewSrc)URL.revokeObjectURL(previewSrc);
    setPreviewArtifactId(null);setPreviewType(null);setPreviewSrc('');setPreviewText('');setPreviewNote('');
  }
  async function openPreview(a:Artifact){
    if(previewArtifactId===a.id){void closePreview();return;}
    await closePreview();
    setPreviewArtifactId(a.id);setPreviewLoading(true);setError('');
    try{
      if(['word','excel','powerpoint'].includes(a.format)){
        const p=await api(`/api/artifacts/${a.id}/preview/`);
        setPreviewType('text');setPreviewText(p.text||'(No extractable text)');setPreviewNote(p.note+(p.truncated?' Preview truncated.':''));
      }else{
        await keycloak.updateToken(30);
        const r=await fetch(API+a.download_path,{headers:{Authorization:`Bearer ${keycloak.token}`}});
        if(!r.ok)throw new Error('Preview could not be loaded: HTTP '+r.status);
        const blob=await r.blob();
        if(a.format==='image'){
          setPreviewSrc(URL.createObjectURL(new Blob([blob],{type:'image/png'})));setPreviewType('image');
        }else if(a.format==='video'){
          setPreviewSrc(URL.createObjectURL(new Blob([blob],{type:'video/mp4'})));setPreviewType('video');
        }else if(a.format==='pdf'){
          setPreviewSrc(URL.createObjectURL(new Blob([blob],{type:'application/pdf'})));setPreviewType('pdf');
        }else if(['python','typescript','javascript','html','css','sql','json','yaml','markdown','text','csv'].includes(a.format)){
          const t=await blob.text();setPreviewText(t.slice(0,60000));setPreviewType('text');
          if(t.length>60000)setPreviewNote('Preview truncated to 60,000 characters. Download the complete file.');
        }else{
          setPreviewNote('No built-in preview for this format. Download to open it.');
        }
      }
    }catch(e){setError(String(e));setPreviewArtifactId(null);}
    finally{setPreviewLoading(false);}
  }
